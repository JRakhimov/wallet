generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Owner {
  id         String   @id @default(uuid()) @db.Uuid
  telegramId BigInt   @unique
  name       String   @default("Мой кошелёк")
  timezone   String   @default("Asia/Tashkent")
  theme      String   @default("system")
  createdAt  DateTime @default(now())
  accounts   Account[]
  categories Category[]
  operations Operation[]
  sessions   Session[]
  budgets    Budget[]
  nutritionProfile NutritionProfile?
  reminders        Reminder[]
  subscriptions    Subscription[]
  meals            Meal[]
  mealPhotos       MealPhoto[]
  workouts         Workout[]
  tasks            Task[]
}

model Session {
  tokenHash String   @id
  ownerId   String   @db.Uuid
  owner     Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}

model Account {
  id         String   @id @default(uuid()) @db.Uuid
  ownerId    String   @db.Uuid
  owner      Owner    @relation(fields: [ownerId], references: [id])
  name       String
  kind       String   @default("card")
  currency   String   @default("UZS")
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())
  entries    Entry[]
  @@index([ownerId])
}

model Category {
  id         String   @id @default(uuid()) @db.Uuid
  ownerId    String   @db.Uuid
  owner      Owner    @relation(fields: [ownerId], references: [id])
  name       String
  kind       String   @default("expense")
  icon       String   @default("shapes")
  archived   Boolean  @default(false)
  favorite   Boolean  @default(false)
  position   Int      @default(0)
  operations Operation[]
  @@index([ownerId, kind])
}

model Operation {
  id             String   @id @default(uuid()) @db.Uuid
  ownerId        String   @db.Uuid
  owner          Owner    @relation(fields: [ownerId], references: [id])
  kind           String
  amount         Decimal  @db.Decimal(20, 2)
  currency       String   @default("UZS")
  // Transfers between accounts in different currencies: UZS per 1 USD, entered by the user.
  rate           Decimal? @db.Decimal(20, 6)
  categoryId     String?  @db.Uuid
  category       Category? @relation(fields: [categoryId], references: [id])
  note           String   @default("")
  occurredAt     DateTime @db.Timestamptz(3)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?
  version        Int      @default(1)
  idempotencyKey String
  requestHash    String
  parentId       String?  @db.Uuid
  parent         Operation? @relation("Refunds", fields: [parentId], references: [id])
  refunds        Operation[] @relation("Refunds")
  entries        Entry[]
  @@unique([ownerId, idempotencyKey])
  @@index([ownerId, occurredAt, id])
  @@index([parentId])
}

model Entry {
  id          String    @id @default(uuid()) @db.Uuid
  operationId String    @db.Uuid
  operation   Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  accountId   String    @db.Uuid
  account     Account   @relation(fields: [accountId], references: [id])
  amount      Decimal   @db.Decimal(20, 2)
  @@unique([operationId, accountId])
  @@index([accountId])
}

model Budget {
  id      String  @id @default(uuid()) @db.Uuid
  ownerId String  @db.Uuid
  owner   Owner   @relation(fields: [ownerId], references: [id])
  month   String
  amount  Decimal @db.Decimal(20, 2)
  @@unique([ownerId, month])
}

// A monthly subscription: charged on the same day of every month.
model Subscription {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @db.Uuid
  owner     Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  amount    Decimal  @db.Decimal(20, 2)
  // 1-31; in a shorter month the charge falls on its last day.
  chargeDay Int
  createdAt DateTime @default(now())

  @@index([ownerId])
}

model BotUpdate {
  updateId BigInt @id
  processedAt DateTime @default(now())
}

// Telegram users the administrator (OWNER_TELEGRAM_ID) let in with /access.
model AccessGrant {
  telegramId BigInt   @id
  grantedAt  DateTime @default(now())
}

// A reminder already checked for a day, so it is sent at most once per owner even after restarts.
model Reminder {
  ownerId   String   @db.Uuid
  owner     Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  kind      String   // lunch | evening | subscription_eve | subscription_morning
  date      String   // yyyy-MM-dd in the owner's timezone
  sent      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@id([ownerId, kind, date])
}

// ---------------------------------------------------------------------------
// Nutrition mini app
// ---------------------------------------------------------------------------

// Body data and goal. BMR, TDEE and calculated targets are derived on every read
// (age changes over time), so only inputs and manual target overrides are stored.
model NutritionProfile {
  ownerId          String   @id @db.Uuid
  owner            Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  sex              String   // male | female
  birthDate        DateTime @db.Date
  heightCm         Int
  weightKg         Decimal  @db.Decimal(5, 1)
  activityLevel    String   // sedentary | light | moderate | high | very_high
  goal             String   @default("lose") // lose | maintain | gain
  deficitPercent   Int      @default(20)
  surplusPercent   Int      @default(10)
  // Manual daily targets; null means "use the calculated value".
  kcalOverride     Int?
  proteinGOverride Int?
  fatGOverride     Int?
  carbsGOverride   Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// A meal in the diary. Created as a draft from LLM analysis (or manually), becomes part of
// the diary once confirmed. Totals are denormalized from items for fast day summaries.
model Meal {
  id             String     @id @default(uuid()) @db.Uuid
  ownerId        String     @db.Uuid
  owner          Owner      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  eatenAt        DateTime   @db.Timestamptz(3)
  source         String     // photo | text
  // analyzing: LLM is working | failed: see error | draft: recognized, awaits review | confirmed: in the diary
  status         String     @default("draft")
  error          String?    // owner-facing reason when status is failed
  comment        String     @default("")
  photoId        String?    @db.Uuid
  photo          MealPhoto? @relation(fields: [photoId], references: [id])
  kcal           Decimal    @db.Decimal(7, 1)
  proteinG       Decimal    @db.Decimal(6, 1)
  fatG           Decimal    @db.Decimal(6, 1)
  carbsG         Decimal    @db.Decimal(6, 1)
  // LLM output kept for the review screen and quality checks: assumptions, questions, meta
  analysis       Json?
  idempotencyKey String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?
  items          MealItem[]

  @@unique([ownerId, idempotencyKey])
  @@index([ownerId, eatenAt])
}

model MealItem {
  id         String  @id @default(uuid()) @db.Uuid
  mealId     String  @db.Uuid
  meal       Meal    @relation(fields: [mealId], references: [id], onDelete: Cascade)
  position   Int
  name       String
  grams      Decimal @db.Decimal(6, 1)
  kcal       Decimal @db.Decimal(7, 1)
  proteinG   Decimal @db.Decimal(6, 1)
  fatG       Decimal @db.Decimal(6, 1)
  carbsG     Decimal @db.Decimal(6, 1)
  confidence String? // low | medium | high, from the LLM; null when entered by hand

  @@index([mealId])
}

// Meal photo stored by PhotoStorage (local disk for now): full image and thumbnail.
model MealPhoto {
  id         String   @id @default(uuid()) @db.Uuid
  ownerId    String   @db.Uuid
  owner      Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  storageKey String
  thumbKey   String
  createdAt  DateTime @default(now())
  meals      Meal[]
}

// A workout: only the active calories burned are kept (e.g. from the watch after a session).
// They are shown next to the diary and never change the daily targets.
model Workout {
  id             String    @id @default(uuid()) @db.Uuid
  ownerId        String    @db.Uuid
  owner          Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  performedAt    DateTime  @db.Timestamptz(3)
  kcal           Int
  durationMin    Int?
  note           String    @default("")
  idempotencyKey String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@unique([ownerId, idempotencyKey])
  @@index([ownerId, performedAt])
}

model Task {
  id             String    @id @default(uuid()) @db.Uuid
  ownerId        String    @db.Uuid
  owner          Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title          String
  note           String    @default("")
  // yyyy-MM-dd in the owner's timezone; null for a note without a date.
  dueDate        String?
  // HH:mm; null for the whole day (reminded in the morning).
  dueTime        String?
  repeat         String    @default("none") // none | daily | weekdays | weekly | monthly | yearly
  // ISO weekdays 1-7 (Monday-Sunday) for a weekly repeat.
  repeatDays     Int[]     @default([])
  // The first date: monthly and yearly repeats keep its day (31 -> 30 -> 31 again).
  anchorDate     String?
  // When the reminder for the current due date is sent; null when there is nothing to send.
  remindAt       DateTime? @db.Timestamptz(3)
  // Set by "remind later" in the bot.
  snoozeAt       DateTime? @db.Timestamptz(3)
  doneAt         DateTime? @db.Timestamptz(3)
  idempotencyKey String
  version        Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@unique([ownerId, idempotencyKey])
  @@index([remindAt])
  @@index([snoozeAt])
  @@index([ownerId, doneAt])
}
