# Local development. NEVER use AUTH_MODE=dev in production.
NODE_ENV=development
# dev: login without Telegram (requires NODE_ENV=development). telegram: Mini App login.
AUTH_MODE=dev

# API
HOST=127.0.0.1
PORT=3001
# From a Docker container use host.docker.internal instead of localhost.
DATABASE_URL=postgresql://wallet:wallet_local_only@localhost:54329/wallet?schema=public
# Frontend URL. Must be HTTPS when NODE_ENV=production.
APP_ORIGIN=http://localhost:5173
# Optional comma-separated CORS list. Replaces APP_ORIGIN for CORS when set.
ALLOWED_ORIGINS=

# Telegram (required when AUTH_MODE=telegram)
BOT_TOKEN=
OWNER_TELEGRAM_ID=
# Production: Telegram pushes updates to the webhook. The URL must be HTTPS and reach the API;
# the secret is 32-256 letters, digits, _ or - (e.g. `openssl rand -hex 32`).
# Without the URL the bot uses long polling.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# In AUTH_MODE=dev the bot is off. Set true to run it locally by polling (needs BOT_TOKEN and
# OWNER_TELEGRAM_ID). Use a separate test bot from @BotFather: a token with a webhook is not
# polled, so the deployed bot keeps working.
BOT_IN_DEV=false
# Optional HTTPS Mini App URL for the /start button. Defaults to APP_ORIGIN.
MINI_APP_URL=
# Optional HTTPS URL of the nutrition Mini App: adds its button to /start.
NUTRITION_APP_URL=
# Optional HTTPS URL of the tasks Mini App: adds its button to /start and to task reminders.
# Add its domain to ALLOWED_ORIGINS too.
TASKS_APP_URL=

# Nutrition meal recognition (optional: without the provider's key the rest works).
# Provider: claude | gemini | openai. Model is required for gemini and openai.
NUTRITION_LLM_PROVIDER=claude
NUTRITION_LLM_MODEL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Assistant in the bot chat: questions about the data and records by text, voice and photo
# ("сколько я потратил на такси?", "запиши расход 45000 за обед"). Optional: without the key
# the bot answers that the assistant is not set up.
# OPENAI_API_KEY above is used for the assistant and for speech recognition (Whisper).
# The model must support function calling; for photos (food, receipts) it must see images.
# A stronger model understands vague requests better and costs more.
ASSISTANT_LLM_MODEL=gpt-6-luna
# To use your own OpenAI-compatible Whisper server, set its URL and model name.
WHISPER_BASE_URL=
WHISPER_MODEL=whisper-1
# Folder for meal photos. In Docker Compose it is a volume at /data/photos.
PHOTO_STORAGE_DIR=data/photos

# Frontend
# API URL baked into the frontend at build time. Empty uses the Vite /api proxy.
VITE_API_BASE_URL=
# Host ports of the frontend containers in Docker Compose.
WEB_PORT=3012
NUTRITION_WEB_PORT=3013
TASKS_WEB_PORT=3014
