{
  "name": "wallet",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "npm run build:api && concurrently -k -n api-ts,api,web -c gray,green,blue \"tsc -p apps/api/tsconfig.json --watch --preserveWatchOutput\" \"node --watch apps/api/dist/main.js\" \"vite --config apps/web/vite.config.ts\"",
    "dev:api": "npm run build:api && concurrently -k -n api-ts,api -c gray,green \"tsc -p apps/api/tsconfig.json --watch --preserveWatchOutput\" \"node --watch apps/api/dist/main.js\"",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "build": "npm run db:generate && npm run build:api && tsc -p apps/web/tsconfig.json && vite build --config apps/web/vite.config.ts",
    "start": "node apps/api/dist/main.js",
    "db:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema apps/api/prisma/schema.prisma",
    "db:studio": "prisma studio --schema apps/api/prisma/schema.prisma",
    "db:up": "docker compose up -d postgres",
    "db:backup": "bash scripts/backup.sh",
    "bot:configure": "node scripts/configure-bot.mjs",
    "test": "tsc -p apps/api/tsconfig.test.json && node --test --test-concurrency=1 apps/api/.test-build/test/*.test.js",
    "test:integration": "tsc -p apps/api/tsconfig.test.json && RUN_DB_TESTS=1 node --test --test-concurrency=1 apps/api/.test-build/test/*.test.js",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.0",
    "@nestjs/core": "^11.2.0",
    "@nestjs/platform-express": "^11.2.0",
    "@prisma/client": "6.19.0",
    "@tanstack/react-query": "^5.90.0",
    "dotenv": "^16.6.1",
    "helmet": "^8.1.0",
    "luxon": "^3.7.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "prisma": "6.19.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.1",
      "effect": "3.20.0"
    }
  }
}
