# Local browser development. NEVER enable AUTH_MODE=dev in production.
# Docker Compose uses these values for its PostgreSQL service and host ports.
POSTGRES_USER=wallet
POSTGRES_PASSWORD=wallet_local_only
POSTGRES_DB=wallet
POSTGRES_PORT=54329
WEB_PORT=5173
NODE_ENV=development
AUTH_MODE=dev
# Local Docker development only. Keep API_BIND_HOST on loopback.
DEV_BYPASS_AUTH=true
API_BIND_HOST=127.0.0.1
VITE_API_BASE_URL=http://localhost:3001
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://wallet:wallet_local_only@localhost:54329/wallet?schema=public
# URL for the API container when PostgreSQL runs on the Docker host.
DOCKER_DATABASE_URL=postgresql://wallet:wallet_local_only@host.docker.internal:54329/wallet?schema=public
BOT_TOKEN=
OWNER_TELEGRAM_ID=
# Optional public HTTPS Mini App URL used by /start.
MINI_APP_URL=
