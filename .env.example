# Local development. NEVER use AUTH_MODE=dev in production.
NODE_ENV=development
# dev: login without Telegram (requires NODE_ENV=development). telegram: Mini App login.
AUTH_MODE=dev

# API
HOST=127.0.0.1
PORT=3001
# From a Docker container use host.docker.internal instead of localhost.
DATABASE_URL=postgresql://wallet:wallet_local_only@localhost:54329/wallet?schema=public
# Frontend URL. Must be HTTPS when NODE_ENV=production.
APP_ORIGIN=http://localhost:5173
# Optional comma-separated CORS list. Replaces APP_ORIGIN for CORS when set.
ALLOWED_ORIGINS=

# Telegram (required when AUTH_MODE=telegram)
BOT_TOKEN=
OWNER_TELEGRAM_ID=
# Optional HTTPS Mini App URL for the /start button. Defaults to APP_ORIGIN.
MINI_APP_URL=

# Frontend
# Vite dev server address. 0.0.0.0 opens it to the local network.
VITE_HOST=127.0.0.1
# API URL baked into the frontend at build time. Empty uses the Vite /api proxy.
VITE_API_BASE_URL=
# Host port of the web container in Docker Compose.
WEB_PORT=3012
